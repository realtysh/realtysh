{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "realtysh-51b01",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_github/**",
      "index_backup_*.html",
      "script_backup_*.js",
      "*.zip"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/script.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "predeploy": [
      "node generate-seo.js"
    ]
  }
}
