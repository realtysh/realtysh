rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if validPost(request.resource.data);
      allow delete: if true;
    }

    function validPost(data) {
      return data.keys().hasOnly([
          'title', 'location', 'propertyType', 'dealType', 'price', 'area',
          'rooms', 'bathrooms', 'imageUrl', 'description', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'title', 'location', 'propertyType', 'dealType', 'price', 'area',
          'rooms', 'bathrooms', 'imageUrl', 'description', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.location is string && data.location.size() > 0 && data.location.size() <= 80
        && data.propertyType in ['apartment', 'house', 'commercial']
        && data.dealType in ['sale', 'lease', 'monthly']
        && data.price is string && data.price.size() > 0 && data.price.size() <= 40
        && data.area is string && data.area.size() > 0 && data.area.size() <= 20
        && data.rooms is string && data.rooms.size() > 0 && data.rooms.size() <= 12
        && data.bathrooms is string && data.bathrooms.size() > 0 && data.bathrooms.size() <= 12
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1000
        && data.description is string && data.description.size() > 0 && data.description.size() <= 3000;
    }
  }
}