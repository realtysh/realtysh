rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && validPost(request.resource.data);
      allow update: if (isAdmin() && validPost(request.resource.data)) || validViewIncrement();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/posts/$(postId))
          && validComment(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /privateComments/{commentId} {
        allow get, list: if isAdmin();
        allow create: if exists(/databases/$(database)/documents/posts/$(postId))
          && validComment(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }


    match /neighborhoodNews/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['message','createdAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // 관리자 오늘 현황: posts/comments와 neighborhoodNews/comments를
    // collectionGroup("comments")로 한 번에 집계할 수 있도록 조회만 허용합니다.
    // 댓글 생성/수정/삭제 권한은 기존 개별 규칙을 그대로 사용합니다.
    match /{path=**}/comments/{commentId} {
      allow list: if isAdmin();
    }

    match /dailyStats/{dateId} {
      allow get: if isAdmin();
      allow list: if false;

      // 첫 방문 또는 첫 매물 조회로 일일 통계 문서를 만들 수 있습니다.
      allow create: if (
          request.resource.data.keys().hasOnly(['visitors'])
          && request.resource.data.visitors == 1
        ) || (
          request.resource.data.keys().hasOnly(['postViews'])
          && request.resource.data.postViews is map
        );

      // 방문자 수 증가 또는 매물별 조회수 증가만 허용합니다.
      allow update: if (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitors'])
          && request.resource.data.visitors is int
          && request.resource.data.visitors == resource.data.visitors + 1
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postViews'])
          && request.resource.data.postViews is map
        );

      allow delete: if isAdmin();
    }

    // 홈페이지 내부 검색어 통계: 고객이 직접 입력한 검색어만 익명 저장하고 관리자는 조회할 수 있습니다.
    match /searchEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['dateKey','keyword','createdAt'])
        && request.resource.data.keys().hasAll(['dateKey','keyword','createdAt'])
        && request.resource.data.dateKey is string && request.resource.data.dateKey.size() == 10
        && request.resource.data.keyword is string && request.resource.data.keyword.size() > 0 && request.resource.data.keyword.size() <= 100
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // 익명 방문 상세: IP는 저장하지 않고, 하루 1회 브라우저 식별값/유입/첫 페이지/기기만 기록합니다.
    match /visitorEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['dateKey','visitorId','source','referrerHost','landingPath','device','createdAt'])
        && request.resource.data.keys().hasAll(['dateKey','visitorId','source','referrerHost','landingPath','device','createdAt'])
        && request.resource.data.dateKey is string && request.resource.data.dateKey.size() == 10
        && request.resource.data.visitorId is string && request.resource.data.visitorId.size() > 5 && request.resource.data.visitorId.size() <= 80
        && request.resource.data.source in ['직접접속','네이버','구글','내부이동','기타']
        && request.resource.data.referrerHost is string && request.resource.data.referrerHost.size() <= 120
        && request.resource.data.landingPath is string && request.resource.data.landingPath.size() <= 500
        && request.resource.data.device in ['PC','모바일','태블릿']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /listingInquiries/{inquiryId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validInquiry(request.resource.data);
      allow get, list: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || validCustomerInquiryUpdate();
      allow delete: if isAdmin();
    }

    function validViewIncrement() {
  return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
    && request.resource.data.views is int
    && request.resource.data.views == (('views' in resource.data) ? resource.data.views + 1 : 1);
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validComment(data) {
      return data.keys().hasOnly(['message', 'createdAt'])
        && data.keys().hasAll(['message', 'createdAt'])
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.createdAt == request.time;
    }


    function validInquiry(data) {
      return data.keys().hasOnly(['ownerUid', 'pinHash', 'name', 'phone', 'propertyType', 'address', 'area', 'price', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['ownerUid', 'pinHash', 'name', 'phone', 'propertyType', 'address', 'area', 'price', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid.size() > 0
        && data.pinHash is string && data.pinHash.size() == 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 30
        && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20
        && data.propertyType in ['apartment', 'commercial', 'warehouse', 'presale', 'land', 'other']
        && data.address is string && data.address.size() > 0 && data.address.size() <= 120
        && data.area is string && data.area.size() <= 40
        && data.price is string && data.price.size() <= 50
        && data.notes is string && data.notes.size() <= 1500
        && data.status in ['new', 'consulting', 'listed', 'hold', 'completed']
        && data.createdAt == request.time && data.updatedAt == request.time;
    }

    function validCustomerInquiryUpdate() {
      return request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.pinHash == resource.data.pinHash
        && request.resource.data.propertyType == resource.data.propertyType
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'area', 'price', 'notes', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 120
        && request.resource.data.area is string && request.resource.data.area.size() <= 40
        && request.resource.data.price is string && request.resource.data.price.size() <= 50
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1500
        && request.resource.data.updatedAt == request.time;
    }

    function validPost(data) {
      return data.keys().hasOnly([
          'title', 'location', 'propertyType', 'dealType', 'price', 'description',
          'area', 'rooms', 'bathrooms', 'imageUrl', 'createdAt', 'updatedAt',
          'infoImageUrl', 'photoUrls', 'representativePhotoUrl', 'youtubeUrl', 'propertyTable', 'brokerTable', 'views', 'featured'
        ])
        && data.keys().hasAll([
          'title', 'location', 'propertyType', 'dealType', 'price', 'description',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.location is string && data.location.size() > 0 && data.location.size() <= 80
        && data.propertyType in ['apartment', 'house', 'commercial', 'warehouse', 'presale', 'land', 'other']
        && data.dealType in ['sale', 'lease', 'monthly']
        && data.price is string && data.price.size() > 0 && data.price.size() <= 40
        && data.description is string && data.description.size() > 0 && data.description.size() <= 10000
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('area' in data) || (data.area is string && data.area.size() <= 20))
        && (!('rooms' in data) || (data.rooms is string && data.rooms.size() <= 12))
        && (!('bathrooms' in data) || (data.bathrooms is string && data.bathrooms.size() <= 12))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('infoImageUrl' in data) || (data.infoImageUrl is string && data.infoImageUrl.size() <= 1000))
        && (!('photoUrls' in data) || (data.photoUrls is list && data.photoUrls.size() <= 20))
        && (!('representativePhotoUrl' in data) || (data.representativePhotoUrl is string && data.representativePhotoUrl.size() <= 1000))
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 500))
        && (!('propertyTable' in data) || (data.propertyTable is list && data.propertyTable.size() <= 100))
        && (!('brokerTable' in data) || (data.brokerTable is list && data.brokerTable.size() <= 20))
        && (!('views' in data) || (data.views is int && data.views >= 0))
        && (!('featured' in data) || data.featured is bool);
    }
  }
}
